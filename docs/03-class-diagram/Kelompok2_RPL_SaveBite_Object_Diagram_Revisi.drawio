style="endArrow=none;html=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;fontStyle=2;" edge="1" parent="1" source="c2" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="terkait" style="endArrow=none;html=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;fontStyle=2;" edge="1" parent="1" source="c8" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="menangani" style="endArrow=none;html=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;fontStyle=2;" edge="1" parent="1" source="c4" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="memverifikasi" style="endArrow=none;html=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;fontStyle=2;" edge="1" parent="1" source="c4" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="&lt;b&gt;KONDISI PADA SNAPSHOT (21 Oktober 2026, 18.15 WIB)&lt;/b&gt;&lt;br&gt;1. Bima (Penjual) memiliki toko Roti Senja yang sudah diverifikasi Admin Sari.&lt;br&gt;2. Dina (Pembeli) memesan 2 Paket Roti Sore: 2 × 20.000 = 40.000 + biaya layanan 1.000 = total 41.000, dibayar dengan QRIS (status paid).&lt;br&gt;3. Pesanan sudah diambil (status redeemed) sehingga stok tersisa 8 dan toko mencatat pemasukan 36.000 (subtotal 40.000 dikurangi komisi 4.000).&lt;br&gt;4. Dina mengajukan pengaduan roti kurang 1 pcs; Admin Sari menindaklanjuti dan status pengaduan selesai.&lt;br&gt;&lt;i&gt;Seluruh data adalah data contoh (fiktif) untuk ilustrasi.&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400.0" y="1440.0" width="1015.0" height="110.0" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;KETERANGAN&lt;/b&gt;&lt;br&gt;&lt;u&gt;nama : Kelas&lt;/u&gt; = objek (instance) dari kelas&lt;br&gt;atribut = nilai pada saat snapshot&lt;br&gt;Garis = link antarobjek (instance dari asosiasi)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40.0" y="1440.0" width="335.0" height="110.0" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
