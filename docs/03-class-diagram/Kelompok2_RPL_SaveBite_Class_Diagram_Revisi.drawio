y></mxCell><mxCell id="c74" value="0..*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="c72"><mxGeometry x="0.82" relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="c75" value="memverifikasi" style="endArrow=none;html=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;fontStyle=2;" edge="1" parent="1" source="c10" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c76" value="0..1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="c75"><mxGeometry x="-0.82" relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="c77" value="0..*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="c75"><mxGeometry x="0.82" relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="c78" value="&lt;b&gt;KETERANGAN&lt;/b&gt;&lt;br&gt;&lt;span style='background:#d5e8d4'&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; Class Utama (transaksi)&lt;br&gt;&lt;span style='background:#dae8fc'&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; Master Data&lt;br&gt;&lt;span style='background:#fff2cc'&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; Pendukung&lt;br&gt;&lt;i&gt;Nama miring&lt;/i&gt; = kelas abstrak&lt;br&gt;- private &amp;nbsp; + public &amp;nbsp; {PK} primary key &amp;nbsp; {FK} foreign key" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40.0" y="1850.0" width="335.0" height="150.0" as="geometry"/></mxCell><mxCell id="c79" value="&lt;b&gt;KETERANGAN RELASI&lt;/b&gt;&lt;br&gt;——— &amp;nbsp;Asosiasi&lt;br&gt;——▷ &amp;nbsp;Generalisasi (pewarisan)&lt;br&gt;◆—— &amp;nbsp;Komposisi (bagian tidak berdiri sendiri)&lt;br&gt;1 = tepat satu; 0..1 = nol atau satu; 0..* = nol atau banyak" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400.0" y="1850.0" width="335.0" height="150.0" as="geometry"/></mxCell><mxCell id="c80" value="&lt;b&gt;CATATAN&lt;/b&gt;&lt;br&gt;1. Pembeli, Penjual, dan Admin mewarisi atribut dan metode Pengguna sesuai aktor use case.&lt;br&gt;2. Satu Penjual memiliki maksimal satu Toko; satu Toko menyediakan banyak Menu.&lt;br&gt;3. Satu Pesanan berisi satu Menu dengan jumlah tertentu; satu Pesanan dapat memiliki beberapa percobaan Pembayaran (QRIS/Midtrans).&lt;br&gt;4. Pesanan yang selesai menghasilkan satu Transaksi pemasukan bagi Toko (dasar saldo Penjual).&lt;br&gt;5. Pengaduan diajukan Pembeli terkait Pesanan dan ditangani Admin.&lt;br&gt;6. Pemetaan tabel: Pengguna→profiles, Toko→merchants, Menu→surprise_bags, Pesanan→orders, Pembayaran→payment_attempts, Transaksi→transactions." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760.0" y="1850.0" width="655.0" height="150.0" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
