# Public Supabase project settings used by both apps
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key
NEXT_PUBLIC_AUTH_CALLBACK_URL=http://localhost:3000/auth/callback

# Set to .savebite.com in production so Google login is shared across subdomains.
# Leave empty for localhost.
NEXT_PUBLIC_COOKIE_DOMAIN=

# Public Midtrans Snap client key only. Never put the server key here.
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=your-public-sandbox-client-key
NEXT_PUBLIC_MIDTRANS_ENVIRONMENT=sandbox

# Optional Caddy routing when a custom domain is available
ROOT_DOMAIN=savebite.localhost
ACME_EMAIL=admin@example.com
