# ---------------------------------------------------------------------------
# Copy to .env (Docker Compose) or .env.local (local `pnpm dev`).
#
# Every NEXT_PUBLIC_* value is inlined into the client bundle at BUILD time, so
# they must be supplied as Docker build args too -- see docker-compose.yml.
# Only public values belong here. Never put the Supabase service-role key, the
# Midtrans server key, or any other secret in this file: it ships to the browser.
# ---------------------------------------------------------------------------

# Supabase project URL and the public anon/publishable key. Required.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key

# Absolute URL of /auth/callback. Required.
# Local:  http://localhost:3000/auth/callback
# VPS:    http://<ip-vps>:3002/auth/callback
# Domain: https://savebite.com/auth/callback
NEXT_PUBLIC_AUTH_CALLBACK_URL=http://localhost:3000/auth/callback

# Set to ".savebite.com" in production so one Google login is shared between the
# root domain and the merchant. subdomain. Must be a bare domain, no scheme and
# no path. Leave empty on localhost (host-only cookies).
NEXT_PUBLIC_COOKIE_DOMAIN=

# Midtrans Snap *client* key only, plus the environment to load Snap.js from.
# Must be "sandbox" or "production"; anything else fails /api/ready at runtime.
# The server key stays in Supabase Edge Functions and must never appear here.
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=your-public-sandbox-client-key
NEXT_PUBLIC_MIDTRANS_ENVIRONMENT=sandbox

# --- Runtime only (not part of the client bundle) --------------------------

# Log verbosity: debug | info | warn | error. Logs are single-line JSON on
# stdout/stderr. Defaults to info.
LOG_LEVEL=info

# --- Optional: custom domain via Caddy -------------------------------------
# Only used by the `caddy` compose profile. Point an A record (and
# merchant.<ROOT_DOMAIN>) at the VPS and open ports 80/443 before enabling it.
ROOT_DOMAIN=savebite.localhost
ACME_EMAIL=admin@example.com
