{
  "name": "savebite-web",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "pnpm --filter @savebite/web dev",
    "build": "pnpm --filter @savebite/web build",
    "typecheck": "pnpm --filter @savebite/web typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "pnpm --filter @savebite/web-shared test && pnpm --filter @savebite/web test",
    "test:coverage": "pnpm --filter @savebite/web-shared test:coverage && pnpm --filter @savebite/web test:coverage",
    "check:migrations": "node scripts/check-migrations.mjs",
    "verify": "pnpm check:migrations && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^15.5.26",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "typescript-eslint": "^8.70.1"
  }
}
